# Copier en .env (ignoré par git) puis remplacer chaque valeur « change-me ».
#   cp .env.example .env

# Mot de passe PostgreSQL
DB_PASSWORD=change-me-db-password

# Clé de signature des JWT (HS256) : au moins 32 caractères, sinon le backend refuse de signer.
#   openssl rand -base64 48
JWT_SECRET=change-me-une-cle-aleatoire-d-au-moins-32-caracteres

# Mots de passe des comptes seed admin@acme.local et user@acme.local
ADMIN_PASSWORD=change-me-admin
USER_PASSWORD=change-me-user

# Modèle de chat Ollama, téléchargé automatiquement par le service ollama-init
OLLAMA_CHAT_MODEL=llama3.2
